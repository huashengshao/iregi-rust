 use crate::{atom::InlineVar, coefficient::ConvertToRing};
 
 use super::*;
+
+/// Expressions visible in the current direct-linearization scope.
+///
+/// Branches inherit their parent's entries, but entries produced inside one
+/// branch must never escape to its sibling. Journaling updates avoids copying
+/// the entire parent map for each branch while retaining that scope rule.
+#[derive(Default)]
+struct ScopedSubexpressions<'a> {
+    entries: HashMap<AtomView<'a>, Slot>,
+    changes: Vec<(AtomView<'a>, Option<Slot>)>,
+    depth: usize,
+    branches: usize,
+    avoided_copied_entries: usize,
+    reverted_entries: usize,
+}
+
+impl<'a> ScopedSubexpressions<'a> {
+    fn get(&self, expression: &AtomView<'a>) -> Option<&Slot> {
+        self.entries.get(expression)
+    }
+
+    fn insert(&mut self, expression: AtomView<'a>, slot: Slot) {
+        let previous = self.entries.insert(expression, slot);
+        if self.depth != 0 {
+            self.changes.push((expression, previous));
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    fn retain(&mut self, keep: impl FnMut(&AtomView<'a>, &mut Slot) -> bool) {
+        // This is used only to discard temporary condition instructions. All
+        // removed slots were created since the condition started; the journal
+        // still safely restores its enclosing branch when that branch ends.
+        self.entries.retain(keep);
+    }
+
+    fn checkpoint(&mut self) -> usize {
+        self.depth += 1;
+        self.branches += 1;
+        self.avoided_copied_entries += self.entries.len();
+        self.changes.len()
+    }
+
+    fn restore(&mut self, checkpoint: usize) {
+        while self.changes.len() > checkpoint {
+            let (expression, previous) = self.changes.pop().unwrap();
+            if let Some(previous) = previous {
+                self.entries.insert(expression, previous);
+            } else {
+                self.entries.remove(&expression);
+            }
+            self.reverted_entries += 1;
+        }
+        self.depth -= 1;
+    }
+
+    fn report(&self, started: std::time::Instant) {
+        if std::env::var_os("SYMBOLICA_SCOPE_PROFILE").is_some() {
+            eprintln!(
+                "symbolica scoped cache: roots_elapsed={:.6}s, branch_scopes={}, parent_entries_not_copied={}, reverted_entries={}, final_entries={}",
+                started.elapsed().as_secs_f64(),
+                self.branches,
+                self.avoided_copied_entries,
+                self.reverted_entries,
+                self.entries.len(),
+            );
+        }
+    }
+}
 
