+fn collect_alias_uses_legacy(
+    value: AtomView<'_>,
+    active: &Atom,
+    definitions: &HashMap<Atom, Atom>,
+    uses: &mut HashMap<Atom, BTreeSet<Atom>>,
+) {
+    if let Some((condition, yes, no)) = if_parts(value) {
+        collect_alias_uses_legacy(condition, active, definitions, uses);
+        collect_alias_uses_legacy(
+            yes,
+            &branch_path(active, condition, true),
+            definitions,
+            uses,
+        );
+        collect_alias_uses_legacy(
+            no,
+            &branch_path(active, condition, false),
+            definitions,
+            uses,
+        );
+        return;
+    }
+    match value {
+        AtomView::Var(_) => {
+            let alias = value.to_owned();
+            if definitions.contains_key(&alias) {
+                uses.entry(alias).or_default().insert(active.clone());
+            }
+        }
+        AtomView::Pow(power) => {
+            for term in power {
+                collect_alias_uses_legacy(term, active, definitions, uses);
+            }
+        }
+        AtomView::Add(sum) => {
+            for term in sum {
+                collect_alias_uses_legacy(term, active, definitions, uses);
+            }
+        }
+        AtomView::Mul(product) => {
+            for term in product {
+                collect_alias_uses_legacy(term, active, definitions, uses);
+            }
+        }
+        AtomView::Fun(function) => {
+            for term in function {
+                collect_alias_uses_legacy(term, active, definitions, uses);
+            }
+        }
+        _ => {}
+    }
+}
