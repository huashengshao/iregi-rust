+fn collect_amplitude_variables_candidate(
+    expression: AtomView<'_>,
+    amplitudes: &HashMap<Atom, Atom>,
+    variables: &mut BTreeSet<Atom>,
+) {
+    if if_parts(expression).is_some() {
+        let value = expression.to_owned();
+        if depends_on_amplitudes(&value, amplitudes) {
+            variables.insert(value);
+        }
+        return;
+    }
+    // Num coefficients deliberately remain opaque, as in the legacy walker.
+    if matches!(expression, AtomView::Num(_)) {
+        return;
+    }
+    if matches!(expression, AtomView::Var(_)) {
+        let value = expression.to_owned();
+        if amplitudes.contains_key(&value) {
+            variables.insert(value);
+        }
+        return;
+    }
+    // Whole IF generators were handled above. Only IF-free subtrees use
+    // Symbolica's indeterminate collection; function heads are not variables.
+    if !expression.contains_symbol(Symbol::IF) {
+        for variable in expression.get_all_indeterminates(true) {
+            if matches!(variable, AtomView::Var(_)) {
+                let value = variable.to_owned();
+                if amplitudes.contains_key(&value) {
+                    variables.insert(value);
+                }
+            }
+        }
+        return;
+    }
+    match expression {
+        AtomView::Var(_) => {
+            let value = expression.to_owned();
+            if amplitudes.contains_key(&value) {
+                variables.insert(value);
+            }
+        }
+        AtomView::Add(sum) => {
+            for term in sum {
+                collect_amplitude_variables_candidate(term, amplitudes, variables);
+            }
+        }
+        AtomView::Mul(product) => {
+            for term in product {
+                collect_amplitude_variables_candidate(term, amplitudes, variables);
+            }
+        }
+        AtomView::Pow(power) => {
+            collect_amplitude_variables_candidate(power.get_base(), amplitudes, variables);
+            collect_amplitude_variables_candidate(power.get_exp(), amplitudes, variables);
+        }
+        AtomView::Fun(function) => {
+            for term in function {
+                collect_amplitude_variables_candidate(term, amplitudes, variables);
+            }
+        }
+        AtomView::Num(_) => {}
+    }
+}
