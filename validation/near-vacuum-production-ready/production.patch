+    let empty = evaluator.evaluate_batch_with_accuracy(&[], 0, &accuracy, REQUIRE).unwrap();
+    assert_eq!(empty.row_count(), 0);
+    assert!(empty.series_execution.is_empty());
+    assert!(evaluator.prepared_series_orders().is_empty());
