+    let tiny = box_point(2f64.powi(-64), c(2., -1.));
+    let mut invalid_scale = vacuum.clone();
+    invalid_scale[10] = c(0., 0.);
+    let mut upper_mass = tiny.clone();
+    upper_mass[6].im = 1.;
