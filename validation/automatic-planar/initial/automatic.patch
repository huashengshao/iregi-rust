+#[test]
+fn auxiliary_preparation_and_metadata_errors_cannot_replace_primary_failure() {
+    let plan = ordinary_plan(Algorithm::PassarinoVeltman);
+    let mut workspace = Workspace::new(plan, 0_f64).unwrap();
+    let batch = KinematicsBatch {
+        rows: 1,
+        components: 1,
+        values: tetra(&0_f64, 1),
+    };
+    let mut baseline = workspace.clone();
+    baseline.planar_fallback = None;
+    let primary = baseline.reduce_batch(&batch).unwrap();
+    assert_ne!(primary.statuses[0], LaneStatus::Success);
+    workspace.planar_fallback.as_mut().unwrap().settings.rank = 8;
+    let rejected = workspace.reduce_batch(&batch).unwrap();
+    assert_eq!(rejected.statuses, primary.statuses);
+    assert!(rejected.fallback_used[0]);
+    assert!(!rejected.analytic_used[0]);
+    assert_eq!(
+        workspace.last_planar_certificate_execution(),
+        CertificateExecutionStats::default()
+    );
+    assert!(
+        workspace.last_diagnostics()[0]
+            .iter()
+            .any(|m| m.contains("preparation failed"))
+    );
+    let mut wrong = Workspace::new(plan, 0_f64).unwrap();
+    wrong.planar_fallback.as_mut().unwrap().settings.convention = Convention::MadLoop;
+    let rejected = wrong.reduce_batch(&batch).unwrap();
+    assert_eq!(rejected.statuses, primary.statuses);
+    assert!(rejected.fallback_used[0] && rejected.analytic_used[0]);
+    assert_eq!(wrong.last_execution().fallback_successes, 0);
+    assert_eq!(
+        wrong.last_planar_certificate_execution().reduction_batches,
+        1
+    );
+    assert!(
+        wrong.last_diagnostics()[0]
+            .iter()
+            .any(|m| m.contains("inconsistent basis, metadata or buffer dimensions"))
+    );
+    assert!(rejected.lane(0).is_err());
+}
