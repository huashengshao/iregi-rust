+    /// Aggregate actual child work while preserving the outer input row count.
+    fn add_child_work(&mut self, child: Self) -> Result<(), ReductionError> {
+        macro_rules! add {
+            ($field:ident) => {
+                self.$field = self
+                    .$field
+                    .checked_add(child.$field)
+                    .ok_or_else(size_error)?;
+            };
+        }
+        add!(argument_rows);
+        add!(master_family_batches);
+        add!(master_rows);
+        add!(pentagon_box_rows);
+        add!(reduction_rows);
+        add!(fallback_rows);
+        add!(fallback_successes);
+        add!(analytic_rows);
+        Ok(())
+    }
+}
