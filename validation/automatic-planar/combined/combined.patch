+#[test]
+fn hybrid_nonplanar_failure_and_planar_recovery_retain_clone_accuracy_lifecycle() {
+    let prototype = Float::new(128);
+    let plan = ordinary_plan(Algorithm::Hybrid);
+    let mut workspace = Workspace::new(plan, prototype.clone()).unwrap();
+    workspace.set_accuracy_precision(53).unwrap();
+    let good = tetra(&prototype, 1);
+    let mut nonplanar = good.clone();
+    nonplanar[16].re = prototype.one();
+    let batch = KinematicsBatch {
+        rows: 3,
+        components: 1,
+        values: [good.clone(), nonplanar, good].concat(),
+    };
+    let mut baseline = workspace.clone();
+    baseline.planar_fallback = None;
+    let primary = baseline.reduce_batch(&batch).unwrap();
+    let reduced = workspace.reduce_batch(&batch).unwrap();
+    eprintln!(
+        "automatic Hybrid128 primary={:?} final={:?}",
+        primary.statuses, reduced.statuses
+    );
+    // Full coordinate rank does not make this symmetric control regular:
+    // q=p1-p0 and r=p4-p0 have q²=-8, r²=-2, q.r=-4, so a
+    // triangle sub-Gram vanishes. Preserve its real primary failure.
+    assert_ne!(primary.statuses[1], LaneStatus::Success);
+    assert_eq!(reduced.statuses[1], primary.statuses[1]);
+    assert!(reduced.fallback_used[1]);
+    assert!(!reduced.analytic_used[1]);
+    assert!(reduced.lane(1).is_err());
+    for i in [0, 2] {
+        assert_eq!(reduced.statuses[i], LaneStatus::Success);
+    }
+    assert_eq!(workspace.last_planar_certificate_execution().input_rows, 3);
+    let mut cloned = workspace.clone();
+    cloned.set_profiling(true);
+    cloned.set_accuracy_precision(80).unwrap();
+    assert_eq!(workspace.accuracy_bits, 53);
+    assert_eq!(cloned.accuracy_bits, 80);
+    assert!(workspace.last_profile().is_none());
+    let strict = cloned.reduce_batch(&batch).unwrap();
+    let mut fresh = Workspace::new(plan, prototype).unwrap();
+    fresh.set_accuracy_precision(80).unwrap();
+    let fresh_result = fresh.reduce_batch(&batch).unwrap();
+    for i in 0..3 {
+        assert_result_lane(&strict, i, &fresh_result, i);
+    }
+    let original = workspace.reduce_batch(&batch).unwrap();
+    for i in 0..3 {
+        assert_result_lane(&original, i, &reduced, i);
+    }
+    assert!(cloned.last_profile().is_some());
+    assert!(workspace.last_profile().is_none());
+}
