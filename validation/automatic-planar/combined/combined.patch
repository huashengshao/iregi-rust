+#[test]
+fn ordered_mixed_shapes_recover_tangent_rows_and_retain_transverse_primary_failure() {
+    let prototype = Float::new(128);
+    let mut configuration = settings(Algorithm::PassarinoVeltman);
+    configuration.convention = Convention::MadLoop;
+    configuration.tensor_weights = TensorWeights::Multinomial;
+    let plan = ReductionPlan::new(configuration).unwrap();
+    for shape in [
+        vec![vec![0, 0], vec![0, 1], vec![1, 0], vec![1, 1]],
+        vec![
+            vec![0, 0],
+            vec![1, 0],
+            vec![0, 1],
+            vec![1, 1],
+            vec![0, 2],
+            vec![2, 0],
+        ],
+    ] {
+        let components = shape.len();
+        let s = shape.iter().position(|v| v == &[1, 0]).unwrap();
+        let t = shape.iter().position(|v| v == &[0, 1]).unwrap();
+        let mixed = 3;
+        let mut tangent = spatial(&prototype, components);
+        for (argument, component) in [
+            (4, s),
+            (8, t),
+            (16, s),
+            (16, t),
+            (20, mixed),
+            (21, mixed),
+            (22, mixed),
+            (23, mixed),
+            (24, mixed),
+        ] {
+            tangent[argument * components + component].re = prototype.one();
+        }
+        let mut transverse = tangent.clone();
+        transverse[16 * components + mixed].re = prototype.one();
+        let mut invalid = tangent.clone();
+        invalid[25 * components].re = -prototype.one();
+        let batch = KinematicsBatch {
+            rows: 5,
+            components,
+            values: [
+                tangent.clone(),
+                transverse,
+                tangent.clone(),
+                invalid,
+                tangent,
+            ]
+            .concat(),
+        };
+        let mut workspace = Workspace::new_dual(
+            &plan,
+            prototype.clone(),
+            HyperDual::<u8>::new(shape.clone()),
+        )
+        .unwrap();
+        workspace.set_accuracy_precision(53).unwrap();
+        let mut baseline = workspace.clone();
+        baseline.planar_fallback = None;
+        let primary = baseline.reduce_batch(&batch).unwrap();
+        let reduced = workspace.reduce_batch(&batch).unwrap();
+        eprintln!(
+            "automatic ordered shape{shape:?} primary={:?} final={:?}",
+            primary.statuses, reduced.statuses
+        );
+        for i in [0, 2, 4] {
+            assert_eq!(reduced.statuses[i], LaneStatus::Success);
+            assert!(reduced.fallback_used[i] && reduced.analytic_used[i]);
+            assert_eq!(reduced.lane(i).unwrap(), reduced.lane(0).unwrap());
+        }
+        assert_eq!(reduced.metadata().dual_shape(), Some(shape.as_slice()));
+        assert_eq!(reduced.metadata().convention(), Convention::MadLoop);
+        assert_eq!(
+            reduced.metadata().tensor_weights(),
+            TensorWeights::Multinomial
+        );
+        assert_ne!(primary.statuses[1], LaneStatus::Success);
+        assert_eq!(reduced.statuses[1], primary.statuses[1]);
+        assert!(reduced.fallback_used[1]);
+        assert!(!reduced.analytic_used[1]);
+        assert!(reduced.lane(1).is_err());
+        assert!(
+            workspace.last_diagnostics()[1].iter().any(
+                |n| n.contains("Taylor component 3") && n.contains("original failure retained")
+            )
+        );
+        assert_eq!(reduced.statuses[3], primary.statuses[3]);
+        assert!(!reduced.fallback_used[3]);
+        let certificate = workspace.last_planar_certificate_execution();
+        assert_eq!(certificate.input_rows, 4);
+        assert_eq!(certificate.reduction_batches, 1);
+        let child = workspace
+            .planar_fallback
+            .as_ref()
+            .unwrap()
+            .workspace
+            .as_ref()
+            .unwrap()
+            .as_ref()
+            .unwrap();
+        let mut expected_proof_work = baseline.last_distance_proof_work();
+        let child_proof_work = child.last_distance_proof_work();
+        assert!(child_proof_work.certificate_rows > 0);
+        expected_proof_work.add(child_proof_work).unwrap();
+        assert_eq!(workspace.last_distance_proof_work(), expected_proof_work);
+        let mut standalone = child.clone();
+        let reference = standalone.reduce_batch(&batch).unwrap();
+        for i in [0, 2, 4] {
+            assert_eq!(reduced.lane(i).unwrap(), reference.lane(i).unwrap());
+        }
+        assert_eq!(workspace.last_execution().fallback_successes, 3);
+    }
+}
