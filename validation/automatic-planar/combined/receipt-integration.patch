+#[test]
+fn stable_nonplanar_primary_is_preserved_alongside_planar_recoveries() {
+    // The ordinary lane is the retained_v1 Float128 N5 rank1 positive
+    // control from validation/public-highpoint/collector-capture-v4-qualification.
+    let prototype = Float::new(128);
+    let mut configuration = settings(Algorithm::Hybrid);
+    configuration.rank = 1;
+    let plan = ReductionPlan::new(configuration).unwrap();
+    let mut workspace = Workspace::new(&plan, prototype.clone()).unwrap();
+    workspace.set_accuracy_precision(53).unwrap();
+    let mut ordinary = row(
+        &prototype,
+        [
+            [0, 0, 0, 0],
+            [0, 1, 0, 0],
+            [0, 2, 1, 0],
+            [0, 3, 0, 1],
+            [0, 4, 0, 0],
