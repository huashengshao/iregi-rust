+#[test]
+fn lazy_capture_partial_valid_coverage_is_cleared_after_fresh_failure() {
+    let (mut workspace, mut batch) = lazy_capture_false_zero_jet();
+    batch.rows = 2;
+    batch.values.extend(
+        lightlike_batch()
+            .values
+            .into_iter()
+            .flat_map(|x| [x, c(0.), c(0.)]),
+    );
+    let exact = batch
+        .values
+        .iter()
+        .map(|value| {
+            Complex::new(
+                value.re.exact_rational().unwrap(),
+                value.im.exact_rational().unwrap(),
+            )
+        })
+        .collect::<Vec<_>>();
+    let checks = workspace.distance_zeros.as_mut().unwrap();
+    assert_eq!(
+        checks
+            .certificate
+            .check_selected_batch(
+                &exact,
+                2,
+                &[vec![(0, 0), (0, 1)], vec![(0, 0), (0, 1), (0, 2)]]
+            )
+            .unwrap(),
+        [ExactZeroCertificate::Zero, ExactZeroCertificate::Zero]
+    );
+    let mut partial = RawDistanceReceipts::new(&batch, checks.domain.clone(), 53, 53);
+    partial.proven[0] = vec![(0, 0), (0, 1)];
+    partial.proven[1] = vec![(0, 0), (0, 1), (0, 2)];
+    let incoming = IncomingDistanceReceipts {
+        receipt: &partial,
+        source_lanes: &[0, 1],
+    };
+    let (failures, receipt, work) = check_lazy(&mut workspace, &batch, Some(&incoming));
+    assert_eq!(failures.len(), 1);
+    assert!(failures[0].1.contains("Taylor component 2"), "{failures:?}");
+    let receipt = receipt.expect("valid partial evidence was captured before fresh failure");
+    assert!(receipt.proven[0].is_empty());
+    assert_eq!(receipt.proven[1], [(0, 0), (0, 1), (0, 2)]);
+    assert_eq!(work.reused_pairs, 5);
+    assert_eq!(work.covered_rows, 1);
+    assert!(work.certificate_rows > 0);
+}
