+fn lazy_capture_false_zero_jet() -> (Workspace<f64>, KinematicsBatch<f64>) {
+    let mut p = plan();
+    p.special_kinematics = true;
+    let dual = HyperDual::<Complex<Rational>>::new(vec![vec![0], vec![1], vec![2]]);
+    let workspace = Workspace::new_dual(&p, 0., dual).unwrap();
+    let large = 134_217_728.;
+    let tangent = [large, large - 2_f64.powi(-26), 2., 0.];
+    let values = row([0.; 4], [4., 4.])
+        .into_iter()
+        .enumerate()
+        .flat_map(|(i, value)| {
+            [
+                value,
+                c(if (4..8).contains(&i) {
+                    tangent[i - 4]
+                } else {
+                    0.
+                }),
+                c(0.),
+            ]
+        })
+        .collect();
+    (
+        workspace,
+        KinematicsBatch {
+            rows: 1,
+            components: 3,
+            values,
+        },
+    )
+}
