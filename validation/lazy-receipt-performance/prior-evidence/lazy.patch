+    /// Materialize call-local coverage only when there is evidence to retain.
+    /// An empty selection or intersection must not allocate a receipt.
+    pub(super) fn record(
+        outgoing: &mut Option<Self>,
+        source: Option<&'source KinematicsBatch<T>>,
+        domain: &Arc<RawDistanceProofDomain>,
+        working_bits: u32,
+        accuracy_bits: u32,
+        original_row: usize,
+        pairs: impl IntoIterator<Item = (usize, usize)>,
+    ) {
+        let Some(source) = source else {
+            return;
+        };
+        let mut pairs = pairs.into_iter();
+        let Some(first) = pairs.next() else {
+            return;
+        };
+        let receipt = outgoing
+            .get_or_insert_with(|| Self::new(source, domain.clone(), working_bits, accuracy_bits));
+        receipt.proven[original_row].push(first);
+        receipt.proven[original_row].extend(pairs);
+    }
 }
 
