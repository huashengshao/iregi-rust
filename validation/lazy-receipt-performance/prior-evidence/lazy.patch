+#[test]
+fn lazy_capture_failed_fresh_proof_and_empty_incoming_do_not_allocate() {
+    let (mut workspace, batch) = lazy_capture_false_zero_jet();
+    let domain = workspace.distance_zeros.as_ref().unwrap().domain.clone();
+    let empty = RawDistanceReceipts::new(&batch, domain, 53, 53);
+    let incoming = IncomingDistanceReceipts {
+        receipt: &empty,
+        source_lanes: &[0],
+    };
+    for incoming in [None, Some(&incoming)] {
+        let (failures, receipt, work) = check_lazy(&mut workspace, &batch, incoming);
+        assert_eq!(failures.len(), 1);
+        assert!(failures[0].1.contains("Taylor component 2"), "{failures:?}");
+        assert!(receipt.is_none());
+        assert_eq!(work.reused_pairs, 0);
+        assert_eq!(work.covered_rows, 0);
+        assert!(work.certificate_rows > 0);
+    }
+}
