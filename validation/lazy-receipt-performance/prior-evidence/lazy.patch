+// Test-only lifecycle probes for the single lazy-capture change. No numerical
+// tolerances, production counters, or public API are altered.
+
+#[test]
+fn lazy_capture_empty_or_disabled_record_has_no_arc_or_storage() {
+    let batch = lightlike_batch();
+    let domain = domain(None);
+    let initial = Arc::strong_count(&domain);
+    let mut receipt = None;
+    RawDistanceReceipts::record(&mut receipt, Some(&batch), &domain, 53, 53, 0, []);
+    assert!(receipt.is_none());
+    assert_eq!(Arc::strong_count(&domain), initial);
+    RawDistanceReceipts::record(&mut receipt, None, &domain, 53, 53, 0, [(0, 0)]);
+    assert!(receipt.is_none());
+    assert_eq!(Arc::strong_count(&domain), initial);
+}
+
+#[test]
+fn lazy_capture_first_evidence_creates_one_context_and_preserves_identity() {
+    let batch = KinematicsBatch {
+        rows: 3,
+        components: 1,
+        values: lightlike_batch().values.repeat(3),
+    };
+    let domain = domain(None);
+    let initial = Arc::strong_count(&domain);
+    let mut receipt = None;
+    RawDistanceReceipts::record(&mut receipt, Some(&batch), &domain, 128, 53, 2, [(0, 0)]);
+    let outer = receipt.as_ref().unwrap().proven.as_ptr();
+    assert_eq!(Arc::strong_count(&domain), initial + 1);
+    RawDistanceReceipts::record(&mut receipt, Some(&batch), &domain, 128, 53, 0, [(0, 1)]);
+    let captured = receipt.as_ref().unwrap();
+    assert_eq!(captured.proven.as_ptr(), outer);
+    assert_eq!(Arc::strong_count(&domain), initial + 1);
+    assert!(std::ptr::eq(captured.source, &batch));
+    assert!(Arc::ptr_eq(&captured.domain, &domain));
+    assert_eq!((captured.working_bits, captured.accuracy_bits), (128, 53));
+    assert_eq!(captured.proven, [vec![(0, 1)], vec![], vec![(0, 0)]]);
+    drop(receipt);
+    assert_eq!(Arc::strong_count(&domain), initial);
+}
+
+#[test]
+fn lazy_capture_ordinary_calls_stay_empty_after_an_earlier_proved_call() {
+    let mut workspace = Workspace::new(&plan(), 0.).unwrap();
+    let ordinary = KinematicsBatch {
+        rows: 2,
+        components: 1,
+        values: row([0., 1., 0., 0.], [4., 9.]).repeat(2),
+    };
+    let zero = lightlike_batch();
+    let (failures, receipt, work) = check_lazy(&mut workspace, &ordinary, None);
+    assert!(failures.is_empty());
+    assert!(receipt.is_none());
+    assert_eq!(work, DistanceProofWork::default());
+    let (failures, receipt, work) = check_lazy(&mut workspace, &zero, None);
+    assert!(failures.is_empty());
+    assert_eq!(receipt.unwrap().proven, [vec![(0, 0)]]);
+    assert!(work.certificate_rows > 0);
+    let (failures, receipt, work) = check_lazy(&mut workspace, &ordinary, None);
+    assert!(failures.is_empty());
+    assert!(receipt.is_none());
+    assert_eq!(work, DistanceProofWork::default());
+}
+
+#[test]
+fn lazy_capture_public_calls_reset_capture_for_ordinary_invalid_and_empty_batches() {
+    let mut workspace = Workspace::new(&plan(), 0.).unwrap();
+    let ordinary = KinematicsBatch {
+        rows: 1,
+        components: 1,
+        values: row([0., 1., 0., 0.], [4., 9.]),
+    };
+    assert_eq!(
+        workspace.reduce_batch(&ordinary).unwrap().statuses,
+        [LaneStatus::Success]
+    );
+    assert!(!workspace.last_outgoing_receipt_present);
+    assert_eq!(workspace.proof_work, DistanceProofWork::default());
+    assert_eq!(
+        workspace.reduce_batch(&lightlike_batch()).unwrap().statuses,
+        [LaneStatus::Success]
+    );
+    assert!(workspace.last_outgoing_receipt_present);
+    assert!(workspace.proof_work.reused_pairs > 0);
+    assert_eq!(
+        workspace.reduce_batch(&ordinary).unwrap().statuses,
+        [LaneStatus::Success]
+    );
+    assert!(!workspace.last_outgoing_receipt_present);
+    assert_eq!(workspace.proof_work, DistanceProofWork::default());
+    assert_eq!(
+        workspace.reduce_batch(&lightlike_batch()).unwrap().statuses,
+        [LaneStatus::Success]
+    );
+    assert!(workspace.last_outgoing_receipt_present);
+    assert!(workspace.proof_work.reused_pairs > 0);
+    let mut invalid = lightlike_batch();
+    invalid.values[10] = c(-1.);
+    assert!(matches!(
+        workspace.reduce_batch(&invalid).unwrap().statuses[0],
+        LaneStatus::InvalidInput(_)
+    ));
+    assert!(!workspace.last_outgoing_receipt_present);
+    assert_eq!(workspace.proof_work, DistanceProofWork::default());
+    assert_eq!(
+        workspace.reduce_batch(&lightlike_batch()).unwrap().statuses,
+        [LaneStatus::Success]
+    );
+    assert!(workspace.last_outgoing_receipt_present);
+    assert!(workspace.proof_work.reused_pairs > 0);
+    let empty = KinematicsBatch {
+        rows: 0,
+        components: 1,
+        values: Vec::new(),
+    };
+    assert!(workspace.reduce_batch(&empty).unwrap().statuses.is_empty());
+    assert!(!workspace.last_outgoing_receipt_present);
+    assert_eq!(workspace.proof_work, DistanceProofWork::default());
+}
